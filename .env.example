TRANSCRIPTION_PROVIDER=gemini
FORMATTER_PROVIDER=gemini
APP_HOTKEY=ctrl+shift
APP_RESTART_HOTKEY=
APP_TITLE_PASTE_HOTKEY=ctrl+'
APP_SCREEN_CAPTURE_HOTKEY=ctrl+shift+space
APP_VOICE_GIF_HOTKEY=ctrl+shift+alt
APP_VIDEO_ATTACH_HOTKEY=ctrl+shift+v
HOTKEY_DEBOUNCE_MS=400
RESTART_DELAY_SECONDS=5

# Native capture
NATIVE_CAPTURE_TARGET=desktop
NATIVE_CAPTURE_FPS=10
NATIVE_CAPTURE_FRAME_LIMIT=3
NATIVE_CAPTURE_ANNOTATION_HOLD_SECONDS=1.5

# Optional Google DevTools MCP bridge
DEVTOOLS_MCP_ENABLED=false
DEVTOOLS_MCP_COMMAND=node scripts/devtools_snapshot.mjs --browser-url http://127.0.0.1:9222 --wait-ms 1500
DEVTOOLS_MCP_CONTEXT_PATH=
DEVTOOLS_MCP_TIMEOUT_SECONDS=8

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini models
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_FORMATTER_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# OpenAI models
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_FORMATTER_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BLOCK_DURATION_MS=200
SILENCE_THRESHOLD=0.015
SILENCE_TIMEOUT_SECONDS=10
AUTO_STOP_ON_SILENCE=false
MAX_RECORDING_SECONDS=180

# Privacy defaults
DEBUG_SAVE_TRANSCRIPTION=false
SAVE_LAST_OUTPUT=false
CLIPBOARD_CLEAR_SECONDS=120
CLIPBOARD_INCLUDE_FILES=false
LOG_TO_FILE=false
