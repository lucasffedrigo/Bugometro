TRANSCRIPTION_PROVIDER=gemini
FORMATTER_PROVIDER=gemini
APP_HOTKEY=ctrl+tab
APP_RESTART_HOTKEY=ctrl+caps lock

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini models
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_FORMATTER_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# OpenAI models
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_FORMATTER_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BLOCK_DURATION_MS=200
SILENCE_TIMEOUT_SECONDS=10
MAX_RECORDING_SECONDS=180

# Privacy defaults
DEBUG_SAVE_TRANSCRIPTION=false
SAVE_LAST_OUTPUT=false
CLIPBOARD_CLEAR_SECONDS=120
LOG_TO_FILE=false
